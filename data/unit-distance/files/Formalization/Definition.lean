/-! Definitions from the approved PDF-derived source contract.
Arithmetic uses actual fields, rings of integers, ideals and embeddings.
The numbered results and external premises belong to subsequent layers. -/

noncomputable section
open scoped NumberField nonZeroDivisors ENNReal
open Set

namespace UnitDistance

/-- A bundled finite extension of the rationals (Definitions A.1–A.2). -/
structure ArithmeticConventions where
  Field : Type
  [field : _root_.Field Field]
  [numberField : NumberField Field]

attribute [instance] ArithmeticConventions.field ArithmeticConventions.numberField

/-- Every complex embedding has real image. -/
def totallyReal (K : Type*) [Field K] [NumberField K] : Prop :=
  ∀ (σ : K →+* ℂ) (x : K), (σ x).im = 0

/-- The absolute value of the integral-basis discriminant. -/
def absoluteDiscriminant (K : Type*) [Field K] [NumberField K] : ℕ :=
  (NumberField.discr K).natAbs

def rootDiscriminant (K : Type*) [Field K] [NumberField K] : ℝ :=
  (absoluteDiscriminant K : ℝ) ^ ((Module.finrank ℚ K : ℝ)⁻¹)

def classNumber (K : Type*) [Field K] [NumberField K] : ℕ :=
  NumberField.classNumber K

/-- Integer exponent in the factorization of a nonzero fractional ideal. -/
def idealValuation {K : Type*} [Field K] [NumberField K]
    (P : IsDedekindDomain.HeightOneSpectrum (𝓞 K))
    (I : (FractionalIdeal (𝓞 K)⁰ K)ˣ) : ℤ :=
  FractionalIdeal.count K P I

/-- The ideal generated by discriminants of full-length integral tuples.
Using the field trace avoids requiring a relative integral basis to be free. -/
def relativeDiscriminant (F M : Type*) [Field F] [NumberField F]
    [Field M] [NumberField M] [Algebra F M] : Ideal (𝓞 F) :=
  Ideal.span {a : 𝓞 F | ∃ b : Fin (Module.finrank F M) → 𝓞 M,
    (a : F) = Algebra.discr F (fun i => (b i : M))}

/-- Complete splitting of a finite prime, including both local degrees. -/
def completelySplit (F M : Type*) [Field F] [NumberField F]
    [Field M] [NumberField M] [Algebra F M]
    (p : Ideal (𝓞 F)) : Prop :=
  p ≠ ⊥ ∧ p.IsPrime ∧
  Nat.card {P : Ideal (𝓞 M) // P.IsPrime ∧
    P.comap (algebraMap (𝓞 F) (𝓞 M)) = p} = Module.finrank F M ∧
  ∀ P : Ideal (𝓞 M), P.IsPrime →
    P.comap (algebraMap (𝓞 F) (𝓞 M)) = p →
    p.ramificationIdx P = 1 ∧ p.inertiaDeg P = 1

/-- No finite prime ramifies and no real embedding becomes complex. -/
def everywhereUnramified (F M : Type*) [Field F] [NumberField F]
    [Field M] [NumberField M] [Algebra F M] : Prop :=
  (∀ (p : Ideal (𝓞 F)) (P : Ideal (𝓞 M)), p ≠ ⊥ → p.IsPrime → P.IsPrime →
    P.comap (algebraMap (𝓞 F) (𝓞 M)) = p → p.ramificationIdx P = 1) ∧
  (∀ σ : M →+* ℂ,
    (∀ x : F, (σ (algebraMap F M x)).im = 0) → ∀ x : M, (σ x).im = 0)

/-- The Frobenius conjugacy class, defined by the residue-power condition
at all choices of a prime above the base prime. -/
def frobeniusClass (F M : Type*) [Field F] [NumberField F]
    [Field M] [NumberField M] [Algebra F M] [IsGalois F M]
    (p : Ideal (𝓞 F)) : Set (M ≃ₐ[F] M) :=
  {σ | p ≠ ⊥ ∧ p.IsPrime ∧ ∃ P : Ideal (𝓞 M), P.IsPrime ∧
    P.comap (algebraMap (𝓞 F) (𝓞 M)) = p ∧ p.ramificationIdx P = 1 ∧
    ∀ x : 𝓞 M, σ (x : M) - (x : M) ^ p.absNorm ∈
      (algebraMap (𝓞 M) M) '' (P : Set (𝓞 M))}

/-- The choices in Definition 2.1. No class-number or growth bound is included. -/
structure AdmissibleDatum where
  L : Type
  [fieldL : Field L]
  [numberFieldL : NumberField L]
  K : Type
  [fieldK : Field K]
  [numberFieldK : NumberField K]
  [extension : Algebra L K]
  realL : totallyReal L
  i : K
  i_sq : i ^ 2 = -1
  generated : Algebra.adjoin L {i} = ⊤
  c : K ≃ₐ[L] K
  c_ne_one : c ≠ 1
  t : ℕ
  t_pos : 0 < t
  q : Fin t → ℕ
  q_prime : ∀ b, Nat.Prime (q b)
  q_distinct : Function.Injective q
  q_mod_four : ∀ b, q b % 4 = 1
  q_split : ∀ b, completelySplit ℚ L (Ideal.span {(q b : 𝓞 ℚ)})

attribute [instance] AdmissibleDatum.fieldL AdmissibleDatum.numberFieldL
  AdmissibleDatum.fieldK AdmissibleDatum.numberFieldK AdmissibleDatum.extension

def admissiblePrimeProduct (A : AdmissibleDatum) : ℕ := ∏ b, A.q b

def admissibleDenominator (A : AdmissibleDatum) : ℕ := admissiblePrimeProduct A ^ 2

def translationGrowth (t : ℕ) (H : ℝ) : ℝ := (t : ℝ) * Real.log 2 - Real.log H

/-- The least modulus through which the character factors. -/
def characterConductor {m : ℕ} (χ : DirichletCharacter ℂ m) : ℕ := χ.conductor

section
attribute [local instance 2000] CyclotomicField.algebra

/-- Intersection of character kernels under the cyclotomic Galois identification. -/
def characterFixedField {m : ℕ} [NeZero m] (X : Set (DirichletCharacter ℂ m)) :
    IntermediateField ℚ (CyclotomicField m ℚ) :=
  IntermediateField.fixedField (Subgroup.closure
    {σ : (CyclotomicField m ℚ) ≃ₐ[ℚ] (CyclotomicField m ℚ) |
      ∀ χ ∈ X, χ ((IsCyclotomicExtension.autEquivPow (n := m) (K := ℚ) (CyclotomicField m ℚ)
        (Polynomial.cyclotomic.irreducible_rat (NeZero.pos m)) σ : (ZMod m)ˣ) : ZMod m) = 1})

end

/-- Least positive cyclotomic modulus admitting an embedding of the field.
Its intended domain is finite abelian extensions of the rationals. -/
def fieldConductor (K : Type*) [Field K] [NumberField K] : ℕ :=
  sInf {m : ℕ | 0 < m ∧ Nonempty (K →ₐ[ℚ] CyclotomicField m ℚ)}

/-- The primitive cubic characters are the choices; their fixed fields and
compositum are obtained from `characterFixedField` and field suprema. -/
structure CubicCharacterDatum where
  ell : ℕ
  ell_pos : 0 < ell
  r : Fin ell → ℕ
  r_prime : ∀ j, Nat.Prime (r j)
  r_distinct : Function.Injective r
  r_mod_three : ∀ j, r j % 3 = 1
  χ : (j : Fin ell) → DirichletCharacter ℂ (r j)
  primitive : ∀ j, characterConductor (χ j) = r j
  cubic : ∀ j, orderOf (χ j) = 3

/-- Unordered two-element subsets at Euclidean distance one.
The geometric consumers apply this to finite sets. -/
def unitDistanceCount (P : Set ℂ) : ℕ :=
  Nat.card {s : Finset ℂ // (↑s : Set ℂ) ⊆ P ∧ s.card = 2 ∧
    ∀ x ∈ s, ∀ y ∈ s, x ≠ y → dist x y = 1}

/-- Supremum of the bounded set of attainable natural-number counts. -/
def unitDistanceMaximum (n : ℕ) : ℕ :=
  sSup {k : ℕ | ∃ P : Finset ℂ, P.card = n ∧ unitDistanceCount (P : Set ℂ) = k}

/-- One extension of each real embedding and a finite set of lattice
translations with unit coordinate lengths. Finiteness of window sections
is a consequence of the lattice theorem, not a field of this structure. -/
structure MinkowskiWindow (A : AdmissibleDatum) where
  σ : Fin (Module.finrank ℚ A.L) → (A.K →+* ℂ)
  embeddings : Function.Bijective (fun j => (σ j).comp (algebraMap A.L A.K))
  U : Finset A.K
  integral_translations : ∀ u ∈ U, IsIntegral ℤ ((admissibleDenominator A : A.K) * u)
  unit_coordinates : ∀ u ∈ U, ∀ j, ‖σ j u‖ = 1
  R : ℝ

/-- Planar overlap area divided by disc area. -/
def discOverlapRatio (R : ℝ) : ℝ :=
  (MeasureTheory.volume (Metric.closedBall (0 : ℂ) R ∩ Metric.closedBall 1 R)).toReal /
    (Real.pi * R ^ 2)

/-- Cardinality of the lattice coset intersected with the closed polydisc. -/
def windowPointCount {A : AdmissibleDatum} (W : MinkowskiWindow A)
    (a : Fin (Module.finrank ℚ A.L) → ℂ) : ℕ :=
  Nat.card {z : Fin (Module.finrank ℚ A.L) → ℂ //
    (∃ x : A.K, IsIntegral ℤ ((admissibleDenominator A : A.K) * x) ∧
      ∀ j, z j = a j + W.σ j x) ∧ ∀ j, ‖z j‖ ≤ W.R}

/-- Ordered endpoint pairs; a pair is counted once, regardless of generators. -/
def windowEdgeCount {A : AdmissibleDatum} (W : MinkowskiWindow A)
    (a : Fin (Module.finrank ℚ A.L) → ℂ) : ℕ :=
  let X : Set (Fin (Module.finrank ℚ A.L) → ℂ) := {z |
    (∃ x : A.K, IsIntegral ℤ ((admissibleDenominator A : A.K) * x) ∧
      ∀ j, z j = a j + W.σ j x) ∧ ∀ j, ‖z j‖ ≤ W.R}
  Nat.card {e : (Fin (Module.finrank ℚ A.L) → ℂ) ×
      (Fin (Module.finrank ℚ A.L) → ℂ) //
    e.1 ∈ X ∧ e.2 ∈ X ∧ ∃ u ∈ W.U, ∀ j, e.2 j - e.1 j = W.σ j u}

/-- Projection of the window section onto its first complex coordinate. -/
def windowProjection {A : AdmissibleDatum} (W : MinkowskiWindow A)
    (a : Fin (Module.finrank ℚ A.L) → ℂ) : Set ℂ :=
  (fun z : Fin (Module.finrank ℚ A.L) → ℂ =>
    z ⟨0, Module.finrank_pos⟩) '' {z |
      (∃ x : A.K, IsIntegral ℤ ((admissibleDenominator A : A.K) * x) ∧
        ∀ j, z j = a j + W.σ j x) ∧ ∀ j, ‖z j‖ ≤ W.R}

/-- Intersection of maximal proper open subgroups, without using the
external powers-and-commutators characterization. -/
def frattiniSubgroup (G : Type*) [Group G] [TopologicalSpace G] : Subgroup G :=
  sInf {M : Subgroup G | IsOpen (M : Set G) ∧ M ≠ ⊤ ∧
    ∀ N : Subgroup G, IsOpen (N : Set G) → M < N → N = ⊤}

/-- Minimal finite size of a topological generating set, with infinity
when no finite generating set exists. -/
def generatorRank (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] : ℕ∞ :=
  sInf {n : ℕ∞ | ∃ S : Finset G, (S.card : ℕ∞) = n ∧
    (Subgroup.closure (S : Set G)).topologicalClosure = ⊤}

/-- Minimal number of closed normal relations in a minimal free pro-p
presentation; infinity when no finite presentation exists. Freeness is
specified by its universal mapping property to finite p-groups, and the
presenting group is required to be profinite with p-group finite quotients. -/
def relationRank (p : ℕ) (_prime : p.Prime) (G : ProfiniteGrp.{0}) : ℕ∞ :=
  sInf {r : ℕ∞ | ∃ n : ℕ, generatorRank G = (n : ℕ∞) ∧
    ∃ F : ProfiniteGrp.{0}, ∃ η : Fin n → F,
      (∀ (N : Subgroup F) (hN : N.Normal), IsOpen (N : Set F) →
        letI := hN
        IsPGroup p (F ⧸ N)) ∧
      (Subgroup.closure (Set.range η)).topologicalClosure = ⊤ ∧
      (∀ H : ProfiniteGrp.{0}, Finite H → IsPGroup p H →
        ∀ f : Fin n → H, ∃! φ : ContinuousMonoidHom F H, ∀ j, φ (η j) = f j) ∧
      ∃ π : ContinuousMonoidHom F G, Function.Surjective π ∧
        ∃ S : Finset F, (S.card : ℕ∞) = r ∧
          (Subgroup.normalClosure (S : Set F)).topologicalClosure = π.toMonoidHom.ker}

/-- The compositum inside a fixed algebraic closure of all finite Galois
p-extensions unramified at finite and infinite places (Definition A.3). -/
def maximalUnramifiedProPExtension (F : Type) [Field F] [NumberField F]
    (p : ℕ) (_prime : p.Prime) : IntermediateField F (AlgebraicClosure F) :=
  sSup {E : IntermediateField F (AlgebraicClosure F) |
    ∃ hE : NumberField E,
      letI := hE
      IsGalois F E ∧ everywhereUnramified F E ∧ IsPGroup p (E ≃ₐ[F] E)}

end UnitDistance
